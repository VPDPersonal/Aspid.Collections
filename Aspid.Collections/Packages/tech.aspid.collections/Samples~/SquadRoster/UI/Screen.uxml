<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Screen.uss" />
    <ui:VisualElement name="screen" class="screen theme-dark">
        <ui:VisualElement class="masthead">
            <ui:Label text="ASPID / COLLECTIONS / 01" class="brand" />
            <ui:Button name="theme" text="Light" class="theme-toggle" tooltip="Switch to light theme" />
        </ui:VisualElement>
        <ui:VisualElement class="hero">
            <ui:VisualElement><ui:Label text="Squad roster" class="title" /><ui:Label text="Add a pair, then move the first member." class="subtitle" /></ui:VisualElement>
            <ui:VisualElement class="metrics"><ui:VisualElement class="metric"><ui:Label text="Members" class="metric-label" /><ui:Label name="metric0" text="0" class="metric-value" /></ui:VisualElement></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="workspace">
            <ui:VisualElement class="toolbar"><ui:Button name="recruit" text="Recruit" class="primary" /><ui:Button name="pair" text="Recruit pair" class="" /><ui:Button name="rotate" text="Rotate" class="" /><ui:Button name="replace" text="Replace first" class="" /><ui:Button name="remove" text="Dismiss first" class="" /><ui:Button name="clear" text="Dismiss all" class="danger" /></ui:VisualElement>
            <ui:ScrollView class="scroll" horizontal-scroller-visibility="Hidden"><ui:VisualElement name="items" class="cards" /></ui:ScrollView>
            <ui:Label name="status" text="Enter Play Mode." class="status" />
        </ui:VisualElement>
        <ui:Foldout name="events" text="+ Events" value="false" class="events">
            <ui:VisualElement class="metrics"><ui:VisualElement class="metric"><ui:Label text="Created" class="metric-label" /><ui:Label name="metric1" text="0" class="metric-value" /></ui:VisualElement><ui:VisualElement class="metric"><ui:Label text="Released" class="metric-label" /><ui:Label name="metric2" text="0" class="metric-value" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement name="log" class="log" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
