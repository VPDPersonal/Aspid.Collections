<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Screen.uss" />
    <ui:VisualElement name="screen" class="screen theme-dark">
        <ui:VisualElement class="masthead">
            <ui:Label text="ASPID / COLLECTIONS / 05" class="brand" />
            <ui:Button name="theme" text="Light" class="theme-toggle" tooltip="Switch to light theme" />
        </ui:VisualElement>
        <ui:VisualElement class="hero">
            <ui:VisualElement><ui:Label text="Detection zone" class="title" /><ui:Label text="Enter Nova twice, then detach the alarm." class="subtitle" /></ui:VisualElement>
            <ui:VisualElement class="metrics"><ui:VisualElement class="metric"><ui:Label text="Inside" class="metric-label" /><ui:Label name="metric0" text="0" class="metric-value" /></ui:VisualElement><ui:VisualElement class="metric"><ui:Label text="Signals" class="metric-label" /><ui:Label name="metric1" text="0" class="metric-value" /></ui:VisualElement></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="workspace">
            <ui:VisualElement class="toolbar"><ui:Button name="enter" text="Enter visitor" class="primary" /><ui:Button name="duplicate" text="Enter NOVA again" class="" /><ui:Button name="leave" text="Leave first" class="" /><ui:Button name="alarm" text="Detach alarm" class="" /><ui:Button name="clear" text="Evacuate" class="danger" /></ui:VisualElement>
            <ui:ScrollView class="scroll" horizontal-scroller-visibility="Hidden"><ui:VisualElement name="items" class="cards" /></ui:ScrollView>
            <ui:Label name="status" text="Enter Play Mode." class="status" />
        </ui:VisualElement>
        <ui:Foldout name="events" text="+ Events" value="false" class="events">
            <ui:VisualElement class="metrics"><ui:VisualElement class="metric"><ui:Label text="Alarm" class="metric-label" /><ui:Label name="metric2" text="0" class="metric-value" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement name="log" class="log" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
