<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Screen.uss" />
    <ui:VisualElement name="screen" class="screen theme-dark">
        <ui:VisualElement class="masthead">
            <ui:Label text="ASPID / COLLECTIONS / 04" class="brand" />
            <ui:Button name="theme" text="Light" class="theme-toggle" tooltip="Switch to light theme" />
        </ui:VisualElement>
        <ui:VisualElement class="hero">
            <ui:VisualElement><ui:Label text="Match scoreboard" class="title" /><ui:Label text="Award points and watch the ranking change." class="subtitle" /></ui:VisualElement>
            <ui:VisualElement class="metrics"><ui:VisualElement class="metric"><ui:Label text="Players" class="metric-label" /><ui:Label name="metric0" text="0" class="metric-value" /></ui:VisualElement></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="workspace">
            <ui:VisualElement class="toolbar"><ui:Button name="score" text="Award +25" class="primary" /><ui:Button name="rival" text="Rival +40" class="" /><ui:Button name="join" text="Join player" class="" /><ui:Button name="leave" text="Leave first" class="" /><ui:Button name="reconnect" text="Reconnect NOVA" class="" /><ui:Button name="clear" text="End match" class="danger" /></ui:VisualElement>
            <ui:ScrollView class="scroll" horizontal-scroller-visibility="Hidden"><ui:VisualElement name="items" class="" /></ui:ScrollView>
            <ui:Label name="status" text="Enter Play Mode." class="status" />
        </ui:VisualElement>
        <ui:Foldout name="events" text="+ Events" value="false" class="events">
            <ui:VisualElement class="metrics"><ui:VisualElement class="metric"><ui:Label text="Created" class="metric-label" /><ui:Label name="metric1" text="0" class="metric-value" /></ui:VisualElement><ui:VisualElement class="metric"><ui:Label text="Released" class="metric-label" /><ui:Label name="metric2" text="0" class="metric-value" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement name="log" class="log" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
